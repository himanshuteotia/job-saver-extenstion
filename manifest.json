{
    "manifest_version": 3,
    "name": "JobSaver",
    "version": "1.0",
    "description": "Save job title, company, and link to Notion",
    "permissions": ["activeTab", "storage", "scripting"],
    "host_permissions": ["<all_urls>"],
    "action": {
      "default_popup": "popup.html"
    },
    "options_page": "options.html"
  }
  